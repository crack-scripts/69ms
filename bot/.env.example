# Discord bot token (from Developer Portal)
TOKEN=YOUR_BOT_TOKEN_HERE

# Channel ID where the bot listens (right-click channel > Copy Channel ID)
CHANNEL_ID=123456789012345678

# Command prefix (default: ".")
PREFIX=.

# Job timeout in milliseconds (default: 125000)
TIMEOUT_MS=125000

# Max concurrent jobs for .l/.dump/.loadstringlog (default: 5)
MAX_CONCURRENT=5

# Path to httplog2.lua (relative to repo root)
LOGGER=69ms/httplog2.lua

# Path to luraphdump.lua (relative to repo root)
DUMPER=69ms/luraphdump.lua

# Path to loadstringlog.lua (relative to repo root)
LOADSTRINGLOG=69ms/loadstringlog.lua
